# Copy this file to .env and fill in real values.
# NEVER commit .env - it is gitignored on purpose.
# Generate strong random secrets with: openssl rand -base64 48

# --- Postgres (source of truth) ---
POSTGRES_USER=piccolo_app
POSTGRES_PASSWORD=change_me_generate_a_strong_random_value
POSTGRES_DB=piccolo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://piccolo_app:change_me_generate_a_strong_random_value@localhost:5432/piccolo

# --- API server ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of allowed origins for CORS. Never use "*" in production.
CORS_ORIGIN=http://localhost:5173
# Access tokens are short-lived; refresh tokens are httpOnly cookies, rotated on use.
JWT_ACCESS_SECRET=change_me_generate_a_strong_random_value
JWT_REFRESH_SECRET=change_me_generate_a_different_strong_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Path on disk (or mounted volume) where uploaded originals are stored, outside the web root.
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_MB=25

# --- Claude / Anthropic (the one paid piece, covered by your existing subscription/API access) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- n8n (self-hosted automation, free) ---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=change_me
N8N_BASIC_AUTH_PASSWORD=change_me_generate_a_strong_random_value
N8N_ENCRYPTION_KEY=change_me_generate_a_strong_random_value
PICCOLO_API_INTERNAL_TOKEN=change_me_generate_a_strong_random_value

# --- Alerts (optional, free) ---
# A Discord incoming webhook: Server Settings -> Integrations -> Webhooks
# -> New Webhook, pick the channel, copy the URL. Ported from the proven
# notify/discord.py in SimsForTT/tenders. Leave blank to skip alerts
# entirely (new-tender and vault-expiry alerts both just no-op).
DISCORD_WEBHOOK_URL=

# --- Web app ---
VITE_API_BASE_URL=http://localhost:4000

# --- Initial admin account (created by `npm run db:seed`, once) ---
# Use the real inbox that should own this system. The seed script refuses
# to run with the placeholder value below so you don't ship a demo login.
ADMIN_EMAIL=changeme@example.com
ADMIN_NAME=Admin
# Must be 12+ characters. Change it after first login.
ADMIN_PASSWORD=change_me_generate_a_strong_random_value
