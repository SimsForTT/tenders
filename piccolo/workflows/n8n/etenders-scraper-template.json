{
  "name": "Piccolo - eTenders scraper template",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 12 }] }
      },
      "id": "twice-daily-schedule",
      "name": "Twice daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "url": "https://www.etenders.gov.za/Home/opportunities",
        "options": { "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "fetch-listing",
      "name": "Fetch listing page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 0],
      "onError": "continueErrorOutput",
      "notes": "IMPORTANT: this URL and the selectors below are a starting point, not verified against the live site from this session. Before enabling: open the real listing page, inspect it, and update both the URL and the CSS selectors in the next node. If the page requires JavaScript to render results, HTTP Request alone won't see them - you'd need a headless-browser node instead, which is a bigger, separate change."
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            { "key": "tenderNo", "cssSelector": ".tender-row .tender-number", "returnValue": "text" },
            { "key": "title", "cssSelector": ".tender-row .tender-title", "returnValue": "text" },
            { "key": "client", "cssSelector": ".tender-row .tender-department", "returnValue": "text" },
            { "key": "closingAt", "cssSelector": ".tender-row .closing-date", "returnValue": "text" }
          ]
        }
      },
      "id": "extract-fields",
      "name": "Extract fields (adjust selectors)",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Parse whatever date format the selector above actually returns, and\n// attach the platform id. Keep this defensive: a scraper that throws on\n// one malformed row should skip that row, not kill the whole run.\nconst PLATFORM_ID = 'REPLACE-WITH-ETENDERS-PLATFORM-UUID';\nconst out = [];\nfor (const item of items) {\n  try {\n    const closing = new Date(item.json.closingAt);\n    if (!item.json.tenderNo || isNaN(closing.getTime())) continue;\n    out.push({\n      json: {\n        tenderNo: item.json.tenderNo.trim().slice(0, 120),\n        client: (item.json.client || 'Unknown').trim().slice(0, 300),\n        title: (item.json.title || '').trim().slice(0, 500),\n        closingAt: closing.toISOString(),\n        sourcePlatformId: PLATFORM_ID,\n      },\n    });\n  } catch (e) {\n    continue;\n  }\n}\nreturn out;"
      },
      "id": "normalize",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PICCOLO_API_BASE_URL}}/internal/leads",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.PICCOLO_API_INTERNAL_TOKEN}}" }] },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "tenderNo", "value": "={{$json.tenderNo}}" },
            { "name": "client", "value": "={{$json.client}}" },
            { "name": "title", "value": "={{$json.title}}" },
            { "name": "closingAt", "value": "={{$json.closingAt}}" },
            { "name": "sourcePlatformId", "value": "={{$json.sourcePlatformId}}" }
          ]
        }
      },
      "id": "create-lead",
      "name": "POST /internal/leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PICCOLO_API_BASE_URL}}/internal/platforms/REPLACE-WITH-ETENDERS-PLATFORM-UUID/health",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.PICCOLO_API_INTERNAL_TOKEN}}" }] },
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "resultCount", "value": "={{$items().length}}" }, { "name": "success", "value": true }] }
      },
      "id": "report-health-ok",
      "name": "Report health (ok)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PICCOLO_API_BASE_URL}}/internal/platforms/REPLACE-WITH-ETENDERS-PLATFORM-UUID/health",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Token", "value": "={{$env.PICCOLO_API_INTERNAL_TOKEN}}" }] },
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "resultCount", "value": 0 }, { "name": "success", "value": false }] }
      },
      "id": "report-health-fail",
      "name": "Report health (fetch failed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 200],
      "notes": "Wired to Fetch listing page's error output - this is the branch that makes a broken selector or a down site visible instead of silently returning zero tenders forever."
    }
  ],
  "connections": {
    "Twice daily": { "main": [[{ "node": "Fetch listing page", "type": "main", "index": 0 }]] },
    "Fetch listing page": {
      "main": [
        [{ "node": "Extract fields (adjust selectors)", "type": "main", "index": 0 }],
        [{ "node": "Report health (fetch failed)", "type": "main", "index": 0 }]
      ]
    },
    "Extract fields (adjust selectors)": { "main": [[{ "node": "Normalise", "type": "main", "index": 0 }]] },
    "Normalise": {
      "main": [
        [
          { "node": "POST /internal/leads", "type": "main", "index": 0 },
          { "node": "Report health (ok)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
